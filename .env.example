# Local demo defaults. Never commit a real .env file or production identifiers.
TIMEZONE=Africa/Nairobi
SLA_ANSWER_SECONDS=20
SLA_CALLBACK_HOURS=4
DEPARTMENT_MAP_JSON={"Customer Experience":{"extensions":["2001","2002"],"queues":["DEMO-CX"],"ring_groups":["DEMO-CX-RG"]},"Collections":{"extensions":["2101","2102"],"queues":["DEMO-COLLECTIONS"],"ring_groups":["DEMO-COLLECTIONS-RG"]}}

# Optional live PBX mode: python report.py --live
YEASTAR_BASE_URL=
YEASTAR_CLIENT_ID=
YEASTAR_CLIENT_SECRET=
YEASTAR_AUTH_API_VERSION=v1.0
YEASTAR_CDR_API_VERSION=v2.0
YEASTAR_TIME_FORMAT=%m/%d/%Y %H:%M:%S
YEASTAR_VERIFY_TLS=true
YEASTAR_PAGE_SIZE=1000
